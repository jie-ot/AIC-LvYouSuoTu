# 旅有所图 后端环境变量模板，复制为 .env 后填入真实值。

# —— 服务 ——
HOST=0.0.0.0
PORT=8000
# 逗号分隔的前端来源，按 , 解析挂载 CORS，可填写多个
FRONTEND_ORIGINS=http://localhost:3000
# 仅预留给未来确需公网完整 URL 的场景；当前必须留空
PUBLIC_BASE_URL=

# —— 数据库 ——
DATABASE_URL=sqlite:///./data/lvyousuotu.db

# —— 鉴权（Demo 单用户，无感）——
DEFAULT_USER_ID=demo_user_001

# —— 静态资源根目录 ——
STATIC_ROOT=./static

# —— 火山方舟 Agent Plan：文本与图片理解 ——
# 在下一行等号后填写 Agent Plan 专属 API Key（不要填写普通按量 Key）
ARK_PLAN_API_KEY=
ARK_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_CHAT_MODEL=doubao-seed-2.1-turbo
# 代码固定开启思考，reasoning_effort=medium；不启用 Harness
ARK_TEXT_TIMEOUT_SECONDS=120

# —— 火山方舟普通按量 API：图片生成 ——
# 在下一行等号后填写普通方舟 API Key（不要填写 Agent Plan Key）
ARK_IMAGE_API_KEY=
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
ARK_IMAGE_SIZE=2K
ARK_IMAGE_TIMEOUT_SECONDS=120
# Seedream 5.0 pro 不支持 sequential_image_generation，不传该参数

# —— 模型调用超时与重试 ——
DEEPSEEK_PLANNING_TIMEOUT_SECONDS=120
MODEL_MAX_RETRY=1
MODEL_RETRY_BACKOFF_SECONDS=1.0

# —— DeepSeek 行程规划（OpenAI Chat Completions；思考模式由代码强制开启）——
# 旅行规划仅支持这两个模型，默认 Flash；需要填写 DeepSeek 官方 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# 生成流程内部并行度：只影响照片理解、文件读取和多张明信片图生图，不改变接口同步返回策略
PHOTO_ANALYZE_PARALLELISM=10
GENERATION_FILE_IO_PARALLELISM=4
GENERATION_IMAGE_PARALLELISM=5

# —— 工具链总开关 ——
TOOLS_ENABLED=true

# —— A 类：高德（最大化使用其全部能力）——
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
# 免费高德 Key 常见 QPS 上限为 3；后端会按该值节流所有 amap REST 请求
AMAP_MAX_QPS=3
# true 则 amap_* 走官方 MCP Server 而非 REST，全项目二选一
AMAP_MCP_ENABLED=true
AMAP_MCP_SSE_URL=https://mcp.amap.com/sse

# —— A 类：和风天气（可选）——
QWEATHER_API_KEY=
QWEATHER_BASE_URL=https://devapi.qweather.com

# —— A′ 类：社区 MCP ——
RAIL_MCP_ENABLED=true
# 12306 社区 MCP stdio 命令（默认 node 版，可用）；为空即自动降级 B，不报错
# Docker --env-file 会保留外层引号，此处有空格也不要加引号
RAIL_MCP_ENDPOINT=stdio:npx -y 12306-mcp
MCP_WAIT_READY_ON_STARTUP=true
MCP_STARTUP_TIMEOUT_SECONDS=60

# —— A′ 类：飞友 Tripmatch MCP ——
# 只提供航班/铁路中转候选；铁路班次与余票仍由上面的 12306 MCP 查询
VARIFLIGHT_TRIPMATCH_MCP_ENABLED=true
VARIFLIGHT_TRIPMATCH_MCP_URL=https://ai.variflight.com/servers/tripmatch/mcp/
# Tripmatch 与 Aviation 共用同一个飞友 Key；
VARIFLIGHT_API_KEY=
VARIFLIGHT_TRIPMATCH_TIMEOUT_SECONDS=30

# —— A′ 类：飞友 Aviation MCP——
VARIFLIGHT_AVIATION_MCP_ENABLED=true
VARIFLIGHT_AVIATION_MCP_URL=https://ai.variflight.com/servers/aviation/mcp/
VARIFLIGHT_AVIATION_TIMEOUT_SECONDS=30

# —— 工具通用超时/重试 ——
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_RETRY=1
